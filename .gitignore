# Python / Jupyter junk
__pycache__/
*.pyc
.ipynb_checkpoints/

# Hugging Face download cache — these are public model weights that re-download
# automatically; committing them would add many GB for no benefit.
hf_cache/

# Stray empty files created by mistyped commands (safe to ignore)
--limit
--models
--out
--out-dir
--partition=gpu-warp
--perturbed
--preds
--min-chars
ham
smishing

